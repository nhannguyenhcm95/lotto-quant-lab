{
  "name": "lotto-quant-lab",
  "version": "1.0.0",
  "description": "Nền tảng phân tích và dự đoán xổ số đa thuật toán (Vietlott & XSMN) với động cơ kiểm định hồi quy (Backtest Engine)",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx netlify dev",
    "test": "node test/test-unit.js",
    "test:unit": "node test/test-unit.js",
    "test:integration": "node test/test-integration.js",
    "test:e2e": "node test/test-e2e.js",
    "audit:history": "node scripts/audit-history.js --strict",
    "audit:history:strict": "node scripts/audit-history.js --strict",
    "verify:artifacts": "node scripts/verify-artifacts.js",
    "verify:strict": "node scripts/gate-runner.js",
    "verify:fix4": "npm run audit:history && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:all": "npm run verify:strict"
  },
  "keywords": [
    "lottery",
    "vietlott",
    "xsmn",
    "prediction-algorithms",
    "markov-chain",
    "poisson",
    "monte-carlo",
    "backtesting",
    "data-science"
  ],
  "author": "Lotto-Quant Research Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "chartist": "^2.2.0",
    "cheerio": "^1.0.0"
  }
}
